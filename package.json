{
  "name": "dsh-opencode-models",
  "version": "0.1.0",
  "description": "Manage OpenCode Zen free-tier and Go-tier models in settings.yaml: live model listings from opencode.ai, configured-versus-live drift per route, add/remove through four agent tools plus an OpenCode Models settings section.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyouwd1/dsh-opencode-models.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "opencode",
    "zen",
    "models"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
